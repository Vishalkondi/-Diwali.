# Copy to .env and adjust. Both apps read this file from the repo root.
NODE_ENV=development
PORT=4000

# docker compose exposes Postgres on 5434
DATABASE_URL=postgres://diyadash:diyadash@localhost:5434/diyadash
TEST_DATABASE_URL=postgres://diyadash:diyadash@localhost:5434/diyadash_test

# At least 32 characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=dev-only-secret-change-me-please-0123456789abcdef

# Origin allowed to call the API with credentials (the Vite dev server)
CORS_ORIGIN=http://localhost:5173

# Simulated fulfilment clock, in seconds per stage
FULFIL_PLACED_SECONDS=6
FULFIL_PACKING_SECONDS=10
FULFIL_ON_THE_WAY_SECONDS=18
